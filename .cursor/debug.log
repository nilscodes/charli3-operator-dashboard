{"location":"database.ts:153","message":"getLifetimeSpentFiltered entry","data":{"address":"addr1v8pnaya8y4cnevn6nw3h8s3gaeyycc4w3y6u0eekf4xwurc8n5jpu","oracleScriptAddress":"addr1w8kwkd66kr0jnk26jl0rkw0dlkrd0k9gyxld4hqrm3uek8qxsawdq"},"timestamp":1766092037922,"sessionId":"debug-session","runId":"run1","hypothesisId":"A"}
{"location":"database.ts:129","message":"getLifetimeReceived result","data":{"address":"addr1v8pnaya8y4cnevn6nw3h8s3gaeyycc4w3y6u0eekf4xwurc8n5jpu","oracleScriptAddress":"addr1w8kwkd66kr0jnk26jl0rkw0dlkrd0k9gyxld4hqrm3uek8qxsawdq","total":"220000000","query":"\n        SELECT COALESCE(SUM(txo.value), 0) as total\n        FROM tx_out txo\n        WHERE txo.address = $1\n          AND EXISTS (\n            -- Check if any input in this transaction comes from a different address\n            SELECT 1\n            FROM tx_in ti\n            JOIN tx_out input_txo ON ti.tx_out_id = input_txo.tx_id AND ti.tx_out_index = input_txo.index\n            WHERE ti.tx_in_id = txo.tx_id\n              AND input_txo.address != $1\n          )\n      \n          AND NOT EXISTS (\n            -- Exclude transactions involving script address in any output\n            SELECT 1 FROM tx_out script_out\n            WHERE script_out.tx_id = txo.tx_id \n              AND script_out.address = $2\n          )\n          AND NOT EXISTS (\n            -- Exclude transactions involving script address in any input\n            SELECT 1 FROM tx_in ti2\n            JOIN tx_out script_in ON ti2.tx_out_id = script_in.tx_id AND ti2.tx_out_index = script_in.index\n            WHERE ti2.tx_in_id = txo.tx_id\n              AND script_in.address = $2\n          )\n        "},"timestamp":1766092037921,"sessionId":"debug-session","runId":"run1","hypothesisId":"A"}
